{
  "mcpServers": {
    "computer": {
      "command": "cu-desktop",
      "args": ["mcp"]
    },
    "playwright": {
      "command": "npx",
      "args": [
        "-y",
        "@playwright/mcp@0.0.84",
        "--executable-path",
        "/opt/pw-browsers/chromium-1243/chrome-linux64/chrome",
        "--headless",
        "--no-sandbox",
        "--isolated",
        "--output-dir",
        "evidence/_mcp-scratch"
      ]
    }
  }
}
