# ============================================================
# staging slot บนเครื่อง demo (119.59.105.140) — รายชื่อตัวแปรเท่านั้น ไม่มีค่า
# ============================================================
# ไฟล์จริงบนเครื่อง: /opt/gacp-staging/.env.staging  (deploy:deploy 0600)
# ใช้กับ: docker compose -p gacp-staging --env-file .env.staging
#           -f docker-compose.production.yml -f docker-compose.staging.yml
#           -f docker-compose.staging-on-demo-host.yml
# รันบุ๊ค: docs/operations/runbooks/staging-on-demo-host.md
#
# กติกา
# - ทุกค่าสร้างใหม่สำหรับ staging (openssl rand -hex 32) ห้ามคัดลอกจาก .env.demo
#   ยกเว้น Stripe test key และบัญชีรับเงินที่ runbook §4.3 คัดลอก (operator 2026-09-07) เท่านั้น
#   staging เริ่มจากฐานว่าง จึงไม่มีข้อมูลเก่าที่ต้องใช้กุญแจเดิมถอด
# - ห้ามใส่ค่าในไฟล์นี้ ห้าม commit ไฟล์จริง ห้ามพิมพ์ค่าออกจอ แชต หรือ log
# - ไม่มีบรรทัด STAGING_IMAGE_TAG ในไฟล์จริง: export ตอนรันทุกครั้ง
#   (overlay ใช้ :? จึงหยุดถ้าลืม ค่าที่ค้างในไฟล์จะทำให้ตัวกันนี้ไม่ทำงาน)
# - ไม่มี ALLOW_PENDING_SECRETS: staging รันสัญญา production ไม่มี waiver
# - [บังคับ] = boot gate ของ production (config/secrets.js) หรือ compose (:?) ปฏิเสธถ้าว่าง
# ============================================================

# ---- ฐานข้อมูลของ slot นี้ (container gacp-staging-postgres) ----
# overlay ประกอบ DATABASE_URL ของ backend-staging จากสามตัวนี้เอง
# DB_PASSWORD ต้องเป็น hex ล้วน เพราะถูกวางใน URL โดยไม่ escape
DB_USER=
DB_PASSWORD=
STAGING_DB_NAME=

# ---- redis ของ slot นี้ (container gacp-staging-redis) [บังคับ] ----
REDIS_PASSWORD=

# ---- minio ของ slot นี้ (container gacp-staging-minio) [บังคับ ต่อ compose] ----
S3_ACCESS_KEY=
S3_SECRET_KEY=

# ---- ความลับของแอป [บังคับ] ----
HEALTH_JWT_SECRET=
PROVIDER_JWT_SECRET=
ENCRYPTION_KEY=
MASTER_ENCRYPTION_KEY=
HMAC_KEY=
SESSION_SECRET=
QR_SIGNATURE_FALLBACK_SECRET=
PAYMENT_WEBHOOK_SECRET=
# [บังคับ ต่อ compose :?] กุญแจ partner trace API ของ staging (openssl rand -hex 32 ใน runbook §4.3)
# staging.yml มีค่าปริยายที่อยู่ใน git overlay ตัดค่าปริยายนั้นออก ว่าง = compose หยุด
STAGING_PARTNER_TRACE_API_KEY=
# ใช้เข้ารหัส private.pem ของคู่กุญแจ staging ที่สร้างตอนติดตั้ง (ห้ามเปลี่ยนหลังสร้างคู่กุญแจ)
RSA_PRIVATE_KEY_PASSPHRASE=
# sha256(public.pem) ของคู่กุญแจ staging ใส่หลังสร้างคู่กุญแจ (ไม่ลับ ว่างได้ = ไม่ pin)
SIGNING_KEY_FINGERPRINT=

# ---- ความลับเสริม (ว่างได้) ----
DATASET_PSEUDONYM_KEY=
SURVEY_RESPONDENT_KEY=
SURVEY_RESPONDENT_KEYS_RETIRED=
AUDIT_HASH_HMAC=
AUDIT_HASH_KEY=
INTEROP_PARTNER_API_KEYS=
E2E_SECRET=

# ---- การชำระเงิน: Stripe โหมดทดสอบเท่านั้น (sk_test_ / pk_test_) ----
# STRIPE_WEBHOOK_SECRET = whsec ของ webhook endpoint ใหม่ (test mode) ที่สร้างสำหรับ
# https://staging.gacpth.com/api/webhooks/stripe (operator 2026-11-07, runbook §4.6)
# ไม่คัดลอก ไม่อ่าน และไม่ roll secret ของ endpoint demo · live key เป็นของ operator เท่านั้น
PAYMENT_ADAPTER=
STRIPE_CHECKOUT_ENABLED=
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
# [บังคับ] บัญชีรับเงินที่แสดงบนหน้าชำระและเอกสาร
PLATFORM_BANK_NAME=
PLATFORM_BANK_ACCOUNT_NO=
PLATFORM_PROMPTPAY_ID=

# ---- ธงพฤติกรรม (ว่าง = ค่าปริยายใน docker-compose.staging.yml) ----
BCRYPT_ROUNDS=
REQUIRE_MFA_FOR_PRIVILEGED=
AUTH_LOOKUP_USE_HMAC=
APP_FK_USE_TOKEN=
ENABLE_PDPA_FIELD_ENCRYPTION=
AUDIT_CHAIN_VERIFY_FROM_SEQ=
STAGING_PUBLIC_URL=
STAGING_COOKIE_DOMAIN=

# ---- Sentry (ว่าง = ปิด) ----
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=

# ---- ต้องไม่ว่างเพื่อให้ compose แปลงไฟล์ได้เท่านั้น ----
# สี่ service ใน docker-compose.production.yml ที่ overlay ปิดไว้ (backend frontend
# grafana pgadmin) อ้างตัวแปรเหล่านี้แบบ :? และ compose ตรวจทุก service แม้ไม่ได้รัน
# ไม่มี container ใดใน slot นี้อ่านค่า ใส่คำว่า unused-on-staging-slot ได้
# ห้ามใส่ค่าจริงของ demo โดยเฉพาะ DATABASE_URL
DATABASE_URL=
PUBLIC_API_URL=
PUBLIC_WEB_URL=
GRAFANA_PASSWORD=
PGADMIN_PASSWORD=
