{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          { "type": "command", "command": "bash \"$CLAUDE_PROJECT_DIR/scripts/ops/cloud-git-identity.sh\"" }
        ]
      }
    ]
  },
  "extraKnownMarketplaces": {
    "pstack-claude": {
      "source": {
        "source": "github",
        "repo": "michael-denyer/pstack-claude"
      }
    },
    "ponytail": {
      "source": {
        "source": "github",
        "repo": "DietrichGebert/ponytail"
      }
    }
  },
  "enabledPlugins": {
    "pstack@pstack-claude": true,
    "ponytail@ponytail": true
  },
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  }
}
